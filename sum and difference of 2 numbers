#include <stdio.h>

int main() {
    int a, b;
    float c, d;

    // Read two integers and two floats from stdin
    scanf("%d %d", &a, &b);
    scanf("%f %f", &c, &d);

    // Print sum and difference of integers
    printf("%d %d\n", a + b, a - b);

    // Print sum and difference of floats rounded to 1 decimal place
    printf("%.1f %.1f\n", c + d, c - d);

    return 0;
}
